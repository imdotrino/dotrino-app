<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de una cuenta: su nombre SIEMPRE a la vista, que es lo que faltaba en la web. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="20dp" android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <View android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginEnd="8dp" android:background="@drawable/dot" />
        <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/fg" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/device" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/warn" android:textSize="13sp" android:layout_marginTop="4dp"
        android:textIsSelectable="true" android:visibility="gone" />
</LinearLayout>
